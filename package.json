{
  "name": "hellschreiber2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-only Hellschreiber (Feld Hell) transmit/receive terminal for amateur radio",
  "license": "MIT",
  "keywords": [
    "hellschreiber",
    "feld-hell",
    "amateur-radio",
    "ham-radio",
    "digital-modes",
    "dsp",
    "web-audio",
    "audioworklet"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
